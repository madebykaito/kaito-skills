#!/bin/sh
# Install kaito-skills into $KAITO_HOME/store and link them per agent.
# Usage: ./setup [--yes] [--no-gstack] [--no-codegraph] [--uninstall] [--purge]
set -eu

# Windows runs this under Git Bash (MSYS2). Paths stay in /c/Users form here; cygpath converts.
IS_WIN=0
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) IS_WIN=1 ;; esac
posix() { if [ "$IS_WIN" = 1 ]; then cygpath -u "$1"; else printf '%s\n' "$1"; fi; }
if [ "$IS_WIN" = 1 ]; then
  HOME=$(posix "$HOME"); [ -z "${KAITO_HOME:-}" ] || KAITO_HOME=$(posix "$KAITO_HOME")
  # JSON values go to node as arguments; stop Git Bash rewriting the paths inside them.
  MSYS2_ARG_CONV_EXCL='";[;{'; export MSYS2_ARG_CONV_EXCL
fi

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
CODEX_SKILL_DIRS="$HOME/.agents/skills"
CLAUDE_SKILLS="$HOME/.claude/skills"
LINK_DIRS="$CLAUDE_SKILLS $HOME/.agents/skills $CODEX_DIR/skills"

REPO_L="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$REPO_L" && pwd -P)"
KAITO_HOME="${KAITO_HOME:-$HOME/.kaito}"
STORE="$KAITO_HOME/store"
CONFIG="$KAITO_HOME/config.json"
STATE="$KAITO_HOME/state.json"
SETTINGS="$HOME/.claude/settings.json"
NUDGE_LINE='For design, motion, copy, SEO, video, media, research or code-quality work, load helpmekaito first.'
J="$REPO/helpmekaito/scripts/kaito-json.mjs"
SYNC="$REPO/helpmekaito/scripts/kaito-sync.mjs"

GSTACK=1 CODEGRAPH=1 UNINSTALL=0 PURGE=0 YES=0
for a in "$@"; do
  case "$a" in
    --yes) YES=1 ;;
    --no-gstack) GSTACK=0 ;;
    --no-codegraph) CODEGRAPH=0 ;;
    --uninstall) UNINSTALL=1 ;;
    --purge) UNINSTALL=1 PURGE=1 ;;
    *) echo "usage: ./setup [--yes] [--no-gstack] [--no-codegraph] [--uninstall] [--purge]" >&2; exit 2 ;;
  esac
done

GS="" N_SKILLS=0 N_LINKED=0 N_UNLINKED=0 N_OVERRIDES=0 N_SKIPPED=0
has() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
json_list() { tr -cd 'A-Za-z0-9_.,-' | tr , ' '; }  # ["a","b"] -> a b
to_json() { s=""; for x in $1; do s="$s,\"$x\""; done; echo "[${s#,}]"; }
ours() { case "$1" in "$REPO"/*|"$REPO_L"/*|"$STORE"/*) return 0 ;; esac; return 1; }
# On Windows links are directory junctions; Git Bash reports them as symlinks.
rl() { r=$(readlink "$1"); if [ "$IS_WIN" = 1 ]; then posix "$r"; else printf '%s\n' "$r"; fi; }
mk_link() { if [ "$IS_WIN" = 1 ]; then node "$SYNC" link "$1" "$2"; else ln -s "$1" "$2"; fi; }
re_link() { if [ "$IS_WIN" = 1 ]; then rm "$2" && mk_link "$1" "$2"; else ln -sfn "$1" "$2"; fi; }
foreign() { { [ -e "$1" ] || [ -L "$1" ]; } && ! { [ -L "$1" ] && ours "$(rl "$1")"; }; }
skip() { echo "skip (not ours): $1"; N_SKIPPED=$((N_SKIPPED + 1)); }
die() { echo "setup: $*" >&2; exit 1; }

# Runs before install and uninstall: every rm -rf below hangs off these paths.
check_paths() {
  for v in "$HOME" "$KAITO_HOME"; do
    case "$v" in /*) ;; *) die "HOME and KAITO_HOME must be absolute paths" ;; esac
    case "$v/" in */../*|*/./*) die "HOME and KAITO_HOME must not contain . or .. parts" ;; esac
    case "$v" in *[[:space:]\$\`\"\\]*) die "HOME and KAITO_HOME must not contain spaces, quotes, \$, \` or backslashes; see docs/troubleshooting.md" ;; esac
  done
  h=$(cd "$HOME" && pwd -P) k=${KAITO_HOME%/}
  if [ -d "$KAITO_HOME" ]; then k=$(cd "$KAITO_HOME" && pwd -P); fi
  case "$h/" in "${k%/}"/*) die "KAITO_HOME must not be HOME or a folder above it" ;; esac
  if [ "$PURGE" = 1 ] && [ -d "$KAITO_HOME" ] && [ ! -e "$CONFIG" ] && [ ! -d "$STORE" ]; then
    die "$KAITO_HOME does not look like a kaito home, not purging it"
  fi
}

# One setup at a time; settings.json and state.json must parse before anything is changed.
lock_and_check() {
  mkdir -p "$KAITO_HOME"
  mkdir "$KAITO_HOME/.setup.lock" 2>/dev/null || die "another setup is running (if not, remove $KAITO_HOME/.setup.lock)"
  trap 'rmdir "$KAITO_HOME/.setup.lock" 2>/dev/null || :' EXIT
  trap 'exit 130' INT TERM
  for f in "$STATE" "$SETTINGS"; do
    node "$J" check "$f" 2>/dev/null || die "$f is not valid JSON; fix it (or delete it) and re-run"
  done
}

# ask <key> "<question>" <y|n>: returns 0 for yes. KAITO_ANSWERS ("key=y,key=n") beats
# --yes, which beats the tty. An unlisted key, or no tty, means the default.
ask() {
  d=$3 a=""
  P=",${KAITO_ANSWERS:-},"
  case "$P" in
    *",$1="*) a=${P#*",$1="}; a=${a%%,*} ;;
    *) if [ "$YES" = 0 ] && { true </dev/tty; } 2>/dev/null; then
         [ "$d" = y ] && h="Y/n" || h="y/N"
         { printf '%s [%s] ' "$2" "$h" >/dev/tty && read -r a </dev/tty; } 2>/dev/null || a=""
       fi ;;
  esac
  case "${a:-$d}" in [yY]*) return 0 ;; *) return 1 ;; esac
}

# interactive: a tty and no --yes. --yes alone never answers a question that has no safe default.
interactive() { [ "$YES" = 0 ] && { true </dev/tty; } 2>/dev/null; }
# answer_for <key>: the KAITO_ANSWERS value. Values can't contain commas.
answer_for() {
  P=",${KAITO_ANSWERS:-},"
  a=${P#*",$1="}; echo "${a%%,*}"
}
has_answer() { case ",${KAITO_ANSWERS:-}," in *",$1="*) return 0 ;; esac; return 1; }

# ask_text <key> "<question>" <default>: echoes the answer. Same precedence as ask.
ask_text() {
  a=""
  if has_answer "$1"; then a=$(answer_for "$1")
  elif interactive; then
    { printf '%s [%s] ' "$2" "$3" >/dev/tty && read -r a </dev/tty; } 2>/dev/null || a=""
  fi
  if has_answer "$1" || [ -n "$a" ]; then echo "$a"; else echo "$3"; fi
}

# ask_choice <key> "<question>" <opt1|opt2|...> <default>: echoes one option, or the default.
ask_choice() {
  a=$(ask_text "$1" "$2 ($3)" "$4")
  case "|$3|" in *"|$a|"*) echo "$a" ;; *) echo "$4" ;; esac
}

check_prereqs() {
  # ponytail: paths are passed around in space-separated lists; quote them all if this bites
  case "$REPO" in *[[:space:]]*) die "the repo path must not contain spaces" ;; esac
  for c in git node npm; do
    command -v "$c" >/dev/null || { echo "setup needs $c on PATH" >&2; exit 1; }
  done
}

make_config() {
  [ -e "$CONFIG" ] && return
  mkdir -p "$KAITO_HOME"
  cat > "$CONFIG" <<'EOF'
{"version":1,"hot":[],"gstack":true,"codegraph":{"auto_index":"ask"},"obsidian":{"enabled":false,"vault_path":"madebykaito/helpmekaito","api_url":null}}
EOF
}

install_store() {
  SKILLS=""
  mkdir -p "$STORE"
  set --
  for d in "$REPO"/*/; do
    d=${d%/} n=${d##*/}
    [ -f "$d/SKILL.md" ] && [ "$n" != gstack ] || continue
    set -- "$@" "$REPO/$n"
    SKILLS="$SKILLS $n"; N_SKILLS=$((N_SKILLS + 1))
  done
  [ $# -gt 0 ] && node "$SYNC" into -x .git -x node_modules -x dist "$STORE" "$@"
  cp "$REPO/LICENSE" "$REPO/THIRD_PARTY_LICENSES.md" "$STORE/" 2>/dev/null || :  # skills point at these
  # Remove only skills an earlier run put here. Anything else in the store is not ours.
  for n in $(node "$J" get "$STATE" store_skills | json_list); do
    case "$n" in .*) continue ;; esac
    has "$n" "$SKILLS" || rm -rf "${STORE:?}/${n:?}"
  done
  node "$J" set "$STATE" store_skills "$(to_json "$SKILLS")"
  return 0
}

# Build gstack in its store copy (never the repo), render it per host, and pick
# the Claude skills to link into GS. Codex gets no gstack links.
gstack_stage() {
  command -v bun >/dev/null || { echo "setup needs bun on PATH for gstack (or pass --no-gstack)" >&2; exit 1; }
  G="$STORE/gstack"
  mkdir -p "$G"
  # Excluded paths are never deleted in the store, so node_modules and builds survive re-runs.
  node "$SYNC" mirror -x .git -x node_modules -i ./lib/diagram-render/dist -x dist "$REPO/gstack" "$G"
  (
    cd "$G"
    bun install
    bun run build
    v=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)  # the store copy has no .git
    for f in */dist/.version; do if [ -e "$f" ]; then echo "$v" > "$f"; fi; done
    bun --no-env-file --config=/dev/null --eval 'import { chromium } from "playwright"; const b = await chromium.launch(); await b.close();' >/dev/null 2>&1 ||
      bun x playwright install chromium
    for h in claude codex; do
      rm -rf "$STORE/_gstack-$h"
      bun run gen:skill-docs:user --host "$h" --install-root "$G" --out-dir "$STORE/_gstack-$h" --link-root "$STORE/_gstack-$h"
    done
  )
  # A few copied reference files still point at gstack's own install path.
  grep -rl '~/.claude/skills/gstack/' "$STORE/_gstack-claude" | while IFS= read -r f; do
    sed -i.bak "s|~/.claude/skills/gstack/|$G/|g" "$f" && rm "$f.bak"
  done
  if foreign "$CLAUDE_SKILLS/gstack"; then
    echo "warning: $CLAUDE_SKILLS/gstack is not ours, skipping all gstack links"; return 0
  fi
  # The router is the render root; sub-skills are its folders with a SKILL.md.
  [ -f "$STORE/_gstack-claude/SKILL.md" ] && GS=gstack
  for d in "$STORE/_gstack-claude"/*/; do
    d=${d%/} n=${d##*/}
    [ -f "$d/SKILL.md" ] || continue
    if has "$n" "$SKILLS"; then echo "warning: gstack skill $n skipped, kaito skill $n wins"; else GS="$GS $n"; fi
  done
}

# link_dir <dir> <names>: link each name to the store, remove our links not in names.
link_dir() {
  mkdir -p "$1"
  for n in $2; do
    p="$1/$n" t="$STORE/$n"
    has "$n" "$GS" && t="$STORE/_gstack-claude/$n"
    [ "$t" = "$STORE/_gstack-claude/gstack" ] && t="$STORE/_gstack-claude"
    if [ -L "$p" ] && [ "$(rl "$p")" = "$t" ]; then :
    elif [ -L "$p" ] && ours "$(rl "$p")"; then re_link "$t" "$p"; N_LINKED=$((N_LINKED + 1))
    elif [ -e "$p" ] || [ -L "$p" ]; then skip "$p"; continue
    else mk_link "$t" "$p"; N_LINKED=$((N_LINKED + 1))
    fi
    LINKS="$LINKS $p"
    [ "$1" = "$CLAUDE_SKILLS" ] && CLAUDE_LINKED="$CLAUDE_LINKED $n"
  done
  unlink_dir "$1" "$2"
}

unlink_dir() {
  [ -d "$1" ] || return 0
  for p in "$1"/*; do
    [ -L "$p" ] && ! has "${p##*/}" "$2" && ours "$(rl "$p")" || continue
    rm "$p"; N_UNLINKED=$((N_UNLINKED + 1))
  done
}

link_all() {
  LINKS="" CLAUDE_LINKED=""
  HOT=$(node "$J" get "$CONFIG" hot | json_list)
  codex="helpmekaito"
  for n in $HOT; do has "$n" "$SKILLS" && codex="$codex $n"; done
  link_dir "$CLAUDE_SKILLS" "$SKILLS $GS"
  for d in $CODEX_SKILL_DIRS; do link_dir "$d" "$codex"; done
  for d in $LINK_DIRS; do
    [ "$d" = "$CLAUDE_SKILLS" ] || has "$d" "$CODEX_SKILL_DIRS" || unlink_dir "$d" ""
  done
}

# Claude lists every linked skill name-only, except the router and the hot list.
# Any other value is the user's own and is left alone, on re-run and uninstall.
write_overrides() {
  prev=$(node "$J" get "$STATE" managed_overrides | json_list)
  cur=$(node "$J" get "$SETTINGS" skillOverrides)
  MANAGED="" new=""
  for n in $CLAUDE_LINKED; do
    [ "$n" = helpmekaito ] || has "$n" "$HOT" && continue
    case "$cur" in
      *"\"$n\":\"name-only\""*) ;;  # already there: ours to manage even if state.json was lost
      *"\"$n\":"*) continue ;;
      *) new="$new $n" ;;
    esac
    MANAGED="$MANAGED $n"
  done
  # State first, so an interrupted run still knows what it wrote.
  node "$J" set "$STATE" managed_overrides "$(to_json "$prev $MANAGED")"
  for n in $new; do
    node "$J" set "$SETTINGS" "skillOverrides.$n" '"name-only"'; N_OVERRIDES=$((N_OVERRIDES + 1))
  done
  drop_overrides "$prev" "$MANAGED"
}

# drop_overrides <names> <keep>
drop_overrides() {
  c=$(node "$J" get "$SETTINGS" skillOverrides)
  for n in $1; do
    has "$n" "$2" && continue
    case "$c" in *"\"$n\":\"name-only\""*) node "$J" del "$SETTINGS" "skillOverrides.$n" ;; esac
  done
}

write_state() {
  v=unknown
  [ -e "$REPO/.git" ] && v=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo unknown)
  node "$J" set "$STATE" store_version "\"$v\""
  node "$J" set "$STATE" managed_overrides "$(to_json "$MANAGED")"
  node "$J" set "$STATE" links "$(to_json "$LINKS")"
}

codegraph_stage() {
  command -v npm >/dev/null || { echo "codegraph: skipped, npm not found"; return 0; }
  pin=$(cat "$REPO/codegraph.version")
  have=0; case "$(codegraph --version 2>/dev/null || true)" in *"$pin"*) have=1 ;; esac
  # Connecting is tracked on its own: the right version can be installed and still not connected.
  if [ "$have" = 0 ] || [ "$(node "$J" get "$STATE" codegraph_connected)" != "\"$pin\"" ]; then
    if ask codegraph "Install codegraph $pin globally and connect it to Claude and Codex?" y; then
      [ "$have" = 1 ] || npm i -g "@colbymchenry/codegraph@$pin"
      codegraph install --target claude,codex --location global -y
      node "$J" set "$STATE" codegraph_connected "\"$pin\""
    fi
  fi
  gi="${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
  grep -qxF .codegraph "$gi" 2>/dev/null && return 0
  if ask gitignore "Add .codegraph to $gi?" y; then
    mkdir -p "${gi%/*}"; echo .codegraph >> "$gi"
  fi
}

# in_json "<json text>" <string>: true if the string is an element in the text.
in_json() { case "$1" in *"\"$2\""*) return 0 ;; esac; return 1; }

# memory.path from config, ~ expanded, default $KAITO_HOME/memory.
mem_path() {
  m=$(node "$J" get "$CONFIG" memory.path 2>/dev/null | tr -d '"') || m=""
  case "$m" in "~") m=$HOME ;; "~/"*) m="$HOME/${m#"~/"}" ;; "") m="$KAITO_HOME/memory" ;; esac
  echo "${m%/}"
}

# Warn about rules the user owns that still let the agent auto-read credentials.
warn_broad() {
  t=${KAITO_HOME#"$HOME"/}
  node "$J" each "$SETTINGS" permissions.allow | while IFS= read -r r; do
    case "$r" in "Read(~/$t/**)"|"Read(~/$t/*)"|*.env*) ;; *) continue ;; esac
    in_json "$(node "$J" get "$STATE" managed_permissions)" "$r" && continue
    echo "warning: your settings allow $r, which can cover kaito's credentials (.env). Consider narrowing it."
  done
}

# The rules we manage: ~ form only when under HOME, plus absolute Bash rules.
perm_rules() {
  t=${KAITO_HOME#"$HOME"/} s=${STORE#"$HOME"/}
  # Read is narrowed: the store, memory and config, never the whole folder (it holds .env).
  if [ "$t" != "$KAITO_HOME" ]; then
    printf '%s\n' "Read(~/$t/store/**)" "Read(~/$t/memory/**)" "Read(~/$t/config.json)" "Edit(~/$t/memory/**)"
  fi
  mp=$(mem_path)
  case "$mp/" in "$KAITO_HOME/memory/"*) ;; *)
    case "$mp/" in "$HOME"/*) r="~/${mp#"$HOME"/}" ;; *) r="/$mp" ;; esac
    printf '%s\n' "Read($r/**)" "Edit($r/**)" ;;
  esac
  for p in "gstack/bin/*" "gstack/browse/dist/browse *" "helpmekaito/scripts/*"; do
    printf 'Bash(%s/%s)\n' "$STORE" "$p"
    if [ "$s" != "$STORE" ]; then printf 'Bash(~/%s/%s)\n' "$s" "$p"; fi
  done
}

# Rules already in the user's file are left alone and not recorded as ours.
perms_stage() {
  rules=$(perm_rules)  # drop rules an older setup managed and this one no longer writes
  node "$J" each "$STATE" managed_permissions | while IFS= read -r r; do
    printf '%s\n' "$rules" | grep -qxF -- "$r" && continue
    node "$J" rm "$SETTINGS" permissions.allow "\"$r\""
    node "$J" rm "$STATE" managed_permissions "\"$r\""
  done
  warn_broad
  ask perms "Add allow rules for kaito scripts and ~/.kaito?" n || return 0
  perm_rules | while IFS= read -r r; do
    { in_json "$(node "$J" get "$STATE" managed_permissions)" "$r" ||
      ! in_json "$(node "$J" get "$SETTINGS" permissions.allow)" "$r"; } || continue
    node "$J" add "$STATE" managed_permissions "\"$r\""  # state first, as in write_overrides
    node "$J" add "$SETTINGS" permissions.allow "\"$r\""
  done
}

# add_block <file> <begin> <end> <lines>: append a marked block once.
add_block() {
  grep -qxF "$2" "$1" 2>/dev/null && return 0
  mkdir -p "${1%/*}"
  if [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ]; then echo >> "$1"; fi
  printf '%s\n%s\n%s\n' "$2" "$4" "$3" >> "$1"
}
remove_block() {
  [ -f "$1" ] && grep -qxF "$2" "$1" || return 0
  if ! grep -qxF "$3" "$1"; then echo "kaito: $1 has $2 but no $3, left it alone."; return 0; fi
  t=$(mktemp) && sed "/^$2\$/,/^$3\$/d" "$1" > "$t" && cat "$t" > "$1"  # cat keeps symlink and mode
  rm -f "$t"
}

nudge_stage() {
  ask nudge "Add a one-line helpmekaito nudge to ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md?" n || return 0
  for f in "$HOME/.claude/CLAUDE.md" "$CODEX_DIR/AGENTS.md"; do
    add_block "$f" "<!-- kaito:begin -->" "<!-- kaito:end -->" "$NUDGE_LINE"
  done
}

hook_stage() {
  e="{\"hooks\":[{\"type\":\"command\",\"command\":\"cat \\\"$STORE/ponytail/SKILL.md\\\"\"}]}"
  prev=$(node "$J" get "$STATE" managed_hook)
  if [ -n "$prev" ] && [ "$prev" != "$e" ]; then  # KAITO_HOME moved: retire the old hook, whatever the answer below
    node "$J" rm "$SETTINGS" hooks.SessionStart "$prev"; node "$J" del "$STATE" managed_hook; prev=""
  fi
  [ -f "$STORE/ponytail/SKILL.md" ] || return 0
  ask ponytail "Add the ponytail always-on SessionStart hook?" n || return 0
  # The same hook already there and not recorded as ours is the user's: leave it, do not claim it.
  if [ -z "$prev" ]; then case "$(node "$J" get "$SETTINGS" hooks.SessionStart)" in *"$e"*) return 0 ;; esac; fi
  node "$J" set "$STATE" managed_hook "$e"
  node "$J" add "$SETTINGS" hooks.SessionStart "$e"
}

codexwrite_stage() {
  ask codexwrite "Let Codex write to ~/.kaito (adds it to Codex writable_roots)?" n || return 0
  c="$CODEX_DIR/config.toml"
  grep -qF "# kaito:begin" "$c" 2>/dev/null && return 0
  if grep -qE 'writable_roots|^\[sandbox_workspace_write\]' "$c" 2>/dev/null; then
    echo "codex: $c already sets writable_roots, add \"$KAITO_HOME\" to it yourself."; return 0
  fi
  # ponytail: a memory folder outside KAITO_HOME is listed too; --uninstall's fallback matches only the one-root line
  wr="\"$KAITO_HOME\""
  case "$(mem_path)/" in "$KAITO_HOME"/*) ;; *) wr="$wr, \"$(mem_path)\"" ;; esac
  add_block "$c" "# kaito:begin" "# kaito:end" "[sandbox_workspace_write]
writable_roots = [$wr]"
}

consent_uninstall() {
  node "$J" each "$STATE" managed_permissions | while IFS= read -r r; do
    node "$J" rm "$SETTINGS" permissions.allow "\"$r\""
  done
  e=$(node "$J" get "$STATE" managed_hook)
  if [ -n "$e" ]; then node "$J" rm "$SETTINGS" hooks.SessionStart "$e"; fi
  remove_block "$HOME/.claude/CLAUDE.md" "<!-- kaito:begin -->" "<!-- kaito:end -->"
  remove_block "$CODEX_DIR/AGENTS.md" "<!-- kaito:begin -->" "<!-- kaito:end -->"
  remove_block "$CODEX_DIR/config.toml" "# kaito:begin" "# kaito:end"
  # Codex rewrites config.toml and can drop the begin marker. Then take out our exact lines instead.
  c="$CODEX_DIR/config.toml"
  if [ -f "$c" ] && grep -qxF "writable_roots = [\"$KAITO_HOME\"]" "$c"; then
    t=$(mktemp) && sed -e "/^\[sandbox_workspace_write\]\$/{N;\|\nwritable_roots = \[\"$KAITO_HOME\"\]\$|d;}" \
      -e '/^# kaito:end$/d' "$c" > "$t" && cat "$t" > "$c"
    rm -f "$t"
  fi
}

uninstall() {
  consent_uninstall
  names=$(node "$J" get "$STATE" managed_overrides | json_list)
  for p in "$CLAUDE_SKILLS"/*; do  # also covers a lost state.json
    if [ -L "$p" ] && ours "$(rl "$p")"; then names="$names ${p##*/}"; fi
  done
  for d in $LINK_DIRS; do unlink_dir "$d" ""; done
  drop_overrides "$names" ""
  rm -rf "$STORE" "$STATE"
  # gstack registers its own hooks at run time. With the store gone they are dead: let gstack prune them.
  h="$REPO/gstack/bin/gstack-settings-hook"
  if [ -x "$h" ] && command -v bun >/dev/null; then GSTACK_SETTINGS_FILE="$SETTINGS" "$h" prune-stale >/dev/null 2>&1 || :; fi
  [ "$PURGE" = 1 ] && rm -rf "$KAITO_HOME"
  echo "kaito: removed $N_UNLINKED links and the store$([ "$PURGE" = 1 ] && echo " and $KAITO_HOME")."
}

# --- task onboarding. State: config tasks.state (pending|done|skipped), tasks.steps.*, tasks.manager.
# Follows helpmekaito/references/tasks.md. Secrets only through kaito-tasks.sh login, never here.
tset() { node "$J" set "$CONFIG" "$1" "$2"; }
tget() { node "$J" get "$CONFIG" "$1" | tr -d '"'; }
tstep() { [ "$(node "$J" get "$CONFIG" "tasks.steps.$1")" = true ]; }
tmark() { tset "tasks.steps.$1" true; }
# A JSON string, built in sh: node would get a Git Bash path rewritten to C:/ form.
jstr() { printf '"%s"\n' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# obsidian_vaults: one vault folder per line, read from Obsidian's own vault list. Empty: Obsidian has no vault here.
# KAITO_OBSIDIAN_JSON, when set, is the only file read (tests).
obsidian_vaults() {
  if [ -n "${KAITO_OBSIDIAN_JSON+x}" ]; then set -- "$KAITO_OBSIDIAN_JSON"
  else set -- "$HOME/Library/Application Support/obsidian/obsidian.json" "${XDG_CONFIG_HOME:-$HOME/.config}/obsidian/obsidian.json" \
    "$HOME/.var/app/md.obsidian.Obsidian/config/obsidian/obsidian.json" "$HOME/snap/obsidian/current/.config/obsidian/obsidian.json" \
    "${APPDATA:-$HOME/AppData/Roaming}/obsidian/obsidian.json"
  fi
  for f; do
    [ -f "$f" ] || continue
    node -e 'try { for (const v of Object.values(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).vaults || {})) if (v && v.path) console.log(v.path) } catch {}' "$f" |
      while IFS= read -r v; do [ "$IS_WIN" = 0 ] || v=$(posix "$v"); [ -d "$v" ] && echo "$v"; done
    return 0
  done
}
# pick_ids <"id name" lines> <answer>: "all" is every id, numbers pick lines, other words must be an id in the list.
pick_ids() {
  case "$2" in [aA][lL][lL]) printf '%s\n' "$1" | awk '{print $1}'; return 0 ;; esac
  for w in $2; do
    case "$w" in
      *[!0-9]*) printf '%s\n' "$1" | awk -v w="$w" '$1 == w {print $1}' ;;
      *) printf '%s\n' "$1" | awk -v n="$w" 'NR == n {print $1}' ;;
    esac
  done | awk '!seen[$0]++'
}

setup_tasks() {
  TS="$STORE/helpmekaito/scripts/kaito-tasks.sh"
  st=$(tget tasks.state)
  case "$st" in done|skipped)
    ask tasks_change "Change task manager settings?" n || return 0
    tset tasks.state '"pending"'
    for s in manager memory credentials discovery; do tset "tasks.steps.$s" false; done ;;
  esac
  # No one to answer (no tty, --yes alone): leave it for helpmekaito to finish in chat.
  if ! tstep manager && ! interactive && ! has_answer tasks_manager; then
    [ -n "$st" ] || tset tasks.state '"pending"'
    echo "tasks: not set up yet; helpmekaito will ask on your first task."
    return 0
  fi
  if ! tstep manager; then
    m=$(ask_choice tasks_manager "Where do you keep tasks?" "trello|plane|obsidian|asana|jira|other|none" none)
    tset tasks.manager "\"$m\""
    tmark manager
    if [ "$m" = none ]; then tset tasks.state '"skipped"'; return 0; fi
  fi
  m=$(tget tasks.manager)
  if ! tstep memory; then
    cur=$(tget memory.path); d=${cur:-$KAITO_HOME/memory}
    vl=$(obsidian_vaults)
    if [ "$m" = obsidian ]; then
      # Obsidian tasks are notes in the memory folder, so it goes inside a vault Obsidian already knows.
      if [ -z "$vl" ]; then
        echo "tasks: Obsidian has no vault on this machine. Install Obsidian (https://obsidian.md), create or open a vault, then re-run ./setup."
        tset tasks.state '"pending"'; return 0
      fi
      i=1
      if [ "$(printf '%s\n' "$vl" | wc -l | tr -d ' ')" -gt 1 ]; then
        echo "Your Obsidian vaults:"; printf '%s\n' "$vl" | awk '{printf "  %d) %s\n", NR, $0}'
        i=$(ask_text tasks_vault "Vault for tasks (number)" 1)
      fi
      v=$(printf '%s\n' "$vl" | sed -n "${i}p" 2>/dev/null); [ -n "$v" ] || v=$(printf '%s\n' "$vl" | sed -n 1p)
      [ -n "$cur" ] || d="$v/kaito"
    fi
    p=$(ask_text tasks_memory "Memory folder" "$d")
    case "$p" in [A-Za-z]:*) [ "$IS_WIN" = 0 ] || p=$(posix "$p") ;; esac
    [ "$p" = "$KAITO_HOME/memory" ] && [ -z "$cur" ] || tset memory.path "$(jstr "$p")"
    # vault_root is found, never asked: the known vault the memory folder sits in.
    v=$(printf '%s\n' "$vl" | while IFS= read -r x; do case "$p/" in ("$x"/*) echo "$x"; break ;; esac; done)
    if [ -n "$v" ]; then tset obsidian.vault_root "$(jstr "$v")"
    elif [ "$m" = obsidian ]; then echo "tasks: $p is outside your Obsidian vaults, so Obsidian will not show the task notes."
    fi
    tmark memory
  fi
  if ! tstep credentials; then
    case "$m" in
      trello|plane)
        [ "$m" = plane ] && tn=Plane || tn=Trello
        if [ -f "$TS" ] && KAITO_TASKS_MANAGER="$m" sh "$TS" status 2>/dev/null | grep -q '^credentials: yes'; then tmark credentials
        elif interactive && [ -f "$TS" ] && KAITO_TASKS_MANAGER="$m" sh "$TS" login && KAITO_TASKS_MANAGER="$m" sh "$TS" status 2>/dev/null | grep -q '^credentials: yes'; then tmark credentials
        else echo "tasks: $tn credentials are not set. Run this in your terminal, then re-run ./setup:"; echo "  sh $TS login"
          [ "$m" != plane ] || echo "  Or add the Plane connector (MCP) to your agent; helpmekaito uses it when there is no key."
        fi ;;
      asana|jira|other) echo "tasks: add the $m connector (MCP) to your agent so helpmekaito can use it."; tmark credentials ;;
      *) tmark credentials ;;
    esac
  fi
  if ! tstep discovery; then
    case "$m" in trello) tn=Trello; tb=boards; tw="lists, labels, custom fields, member ids and usernames, all IDs, a summary of card style; no card contents" ;;
      plane) tn=Plane; tb=projects; tw="states, modules, labels, member ids and names, all IDs, a summary of work item style; no work item contents" ;; esac
    if [ "$m" != trello ] && [ "$m" != plane ]; then tmark discovery
    elif tstep credentials && [ -f "$TS" ]; then
      bl=$(KAITO_TASKS_MANAGER="$m" sh "$TS" boards 2>/dev/null) || bl=""
      if [ -z "$bl" ]; then
        echo "tasks: found no open $tn $tb on this account. Create one in $tn, then re-run ./setup."
      else
        echo "Your $tn $tb:"; printf '%s\n' "$bl" | awk '{$1 = ""; printf "  %d)%s\n", NR, $0}'
        a=$(ask_text tasks_boards "Which to use: numbers like 1 3, all, or none" all)
        b=$(pick_ids "$bl" "$a" | tr '\n' ' ' | sed 's/ $//')
        if [ "$a" = none ]; then KAITO_TASKS_MANAGER="$m" sh "$TS" consent no && tmark discovery
        elif [ -z "$b" ]; then echo "tasks: nothing matches \"$a\". Re-run ./setup to pick again."
        # shellcheck disable=SC2086  # board ids have no spaces
        elif ask tasks_discover "Sync the structure of these $tb ($tw) into local memory?" y
        then KAITO_TASKS_MANAGER="$m" sh "$TS" consent yes $b && KAITO_TASKS_MANAGER="$m" sh "$TS" discover && tmark discovery
        else KAITO_TASKS_MANAGER="$m" sh "$TS" consent no $b && tmark discovery
        fi
      fi
    fi
  fi
  if tstep manager && tstep memory && tstep credentials && tstep discovery; then tset tasks.state '"done"'
  else tset tasks.state '"pending"'; echo "tasks: unfinished; helpmekaito picks up the rest in chat."
  fi
}

summary() {
  echo "kaito: $N_SKILLS skills installed, $N_LINKED links created, $N_UNLINKED removed, $N_OVERRIDES overrides written, $N_SKIPPED skipped."
}

check_paths
command -v node >/dev/null || die "setup needs node on PATH"
lock_and_check
if [ "$UNINSTALL" = 1 ]; then uninstall; exit 0; fi
check_prereqs
make_config
[ "$(node "$J" get "$CONFIG" gstack)" = false ] && GSTACK=0
install_store
[ "$GSTACK" = 1 ] && gstack_stage
link_all
write_overrides
write_state
setup_tasks
[ "$CODEGRAPH" = 1 ] && codegraph_stage
perms_stage
nudge_stage
hook_stage
codexwrite_stage
summary
