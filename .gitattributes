# LF everywhere, so shell scripts still run after a Windows checkout (core.autocrlf=true).
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mp3 binary
