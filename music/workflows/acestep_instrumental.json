{
 "meta": {
  "name": "acestep_instrumental",
  "engine": "acestep",
  "mode": "instrumental",
  "need_gb": 14,
  "license": "acestep",
  "output": "audio",
  "models": [
   {"node": "CheckpointLoaderSimple", "input": "ckpt_name", "file": "ace_step_1.5_turbo_aio.safetensors"}
  ],
  "defaults": {"seed": 1, "steps": 8, "bpm": 66, "key": "D minor", "sig": "4", "prefix": "audio/kaito_music"},
  "note": "ACE-Step 1.5 turbo, instrumental only, ComfyUI core nodes."
 },
 "graph": {
  "ckpt": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "ace_step_1.5_turbo_aio.safetensors"}},
  "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["ckpt", 0], "shift": 3}},
  "text": {"class_type": "TextEncodeAceStepAudio1.5", "inputs": {"clip": ["ckpt", 1], "tags": "{{tags}}", "lyrics": "[Instrumental]", "seed": "{{seed}}", "bpm": "{{bpm}}", "duration": "{{seconds}}", "timesignature": "{{sig}}", "language": "en", "keyscale": "{{key}}", "generate_audio_codes": true, "cfg_scale": 2.0, "temperature": 0.85, "top_p": 0.9, "top_k": 0, "min_p": 0.0}},
  "zero": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["text", 0]}},
  "latent": {"class_type": "EmptyAceStep1.5LatentAudio", "inputs": {"seconds": "{{seconds}}", "batch_size": 1}},
  "sample": {"class_type": "KSampler", "inputs": {"model": ["shift", 0], "positive": ["text", 0], "negative": ["zero", 0], "latent_image": ["latent", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "dec": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["sample", 0], "vae": ["ckpt", 2]}},
  "save": {"class_type": "SaveAudio", "inputs": {"audio": ["dec", 0], "filename_prefix": "{{prefix}}"}}
 }
}
