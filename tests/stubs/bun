#!/bin/sh
# Fake bun. Logs each call; writes into the cwd the way the real gstack build does.
# BUN_STUB_PROBE_FAIL=1 makes the Chromium launch probe (bun --eval) fail.
# BUN_STUB_SKILLS lists the skill folders a gen:skill-docs:user render writes.
echo "bun $*" >> "$HOME/stub.log"
case "$*" in
  *--eval*) [ "${BUN_STUB_PROBE_FAIL:-0}" = 1 ] && exit 1 ;;
  install) mkdir -p node_modules && touch node_modules/.stub ;;
  "run build") mkdir -p browse/dist && touch browse/dist/browse ;;
  "run gen:skill-docs:user"*)
    while [ $# -gt 0 ]; do [ "$1" = --out-dir ] && out=$2; [ "$1" = --host ] && host=$2; shift; done
    mkdir -p .agents "$out/bin"
    if [ "$host" = codex ]; then
      # Like the real Codex render: everything under .agents/skills, sub-skills prefixed.
      mkdir -p "$out/.agents/skills/gstack" && echo "name: gstack" > "$out/.agents/skills/gstack/SKILL.md"
      for n in ${BUN_STUB_SKILLS:-qa ship}; do
        mkdir -p "$out/.agents/skills/gstack-$n" && echo "name: $n" > "$out/.agents/skills/gstack-$n/SKILL.md"
      done
      exit 0
    fi
    # Like the real Claude render: router at the root, a non-skill bin/, one stray home path.
    echo "name: gstack" > "$out/SKILL.md"
    for n in ${BUN_STUB_SKILLS:-qa ship}; do
      mkdir -p "$out/$n" && echo "name: $n" > "$out/$n/SKILL.md"
    done
    echo 'run ~/.claude/skills/gstack/bin/x' > "$out/qa-ref.md" ;;
esac
exit 0
